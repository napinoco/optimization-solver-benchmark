# Optimization Solver Benchmark System - Docker Environment Configuration
# Copy this file to .env and customize for your environment

# Container resource limits
MEMORY_LIMIT=16g
MEMORY_RESERVATION=4g
CPU_LIMIT=4.0
CPU_RESERVATION=1.0

# User permissions (automatically detected, but can be overridden)
# USER_ID=1000
# GROUP_ID=1000

# Benchmark execution settings
BENCHMARK_TIMEOUT=120

# Timezone configuration
TZ=UTC

# MATLAB license configuration
# MLM_LICENSE_FILE=/home/solver/.matlab/R2023b_licenses/license.lic

# Development vs production mode
CONTAINER_ENV=development

# Python configuration
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Logging level
LOG_LEVEL=INFO

# Custom solver configurations (optional)
# ENABLE_MATLAB_SOLVERS=true
# ENABLE_OCTAVE_FALLBACK=true

# Volume mount overrides (advanced)
# PROBLEMS_DIR=../problems
# DATABASE_DIR=../database
# DOCS_DIR=../docs
# CONFIG_DIR=../config

# Network configuration (advanced)
# DOCKER_NETWORK_SUBNET=172.20.0.0/16

# Security options (advanced)
# DOCKER_SECURITY_OPTS=no-new-privileges:true